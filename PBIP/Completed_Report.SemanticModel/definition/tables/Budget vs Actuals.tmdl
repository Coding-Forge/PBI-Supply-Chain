	partition 'Budget vs Actuals' = m
		mode: import
		source =
				let
				  Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/Coding-Forge/PBI-Supply-Chain/main/Coding-Forge_Data/Financial%20Data%20-%20Budget%20vs%20Actuals.csv"), [Delimiter = ",", Columns = 13, QuoteStyle = QuoteStyle.None]),
