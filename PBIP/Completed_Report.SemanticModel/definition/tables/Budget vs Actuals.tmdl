				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {{"Program ID", type text}, {"Program Name", type text}, {"Fiscal Year", type text}, {"Quarter", type text}, {"Cost Center", type text}, {"Budget Category", type text}, {"Budgeted Amount", Currency.Type}, {"Actual Amount", type text}, {"Variance", type text}, {"Variance %", type text}, {"Funding Source", type text}, {"Contract Number", type text}, {"Status", type text}}),
				  #"Filtered rows" = Table.SelectRows(#"Changed column type", each Text.StartsWith([Program ID], "PRG")),
				  #"Removed duplicates" = Table.Distinct(#"Filtered rows", {"Program ID", "Program Name", "Fiscal Year", "Quarter", "Cost Center", "Budget Category", "Budgeted Amount", "Actual Amount", "Variance", "Variance %", "Funding Source", "Contract Number", "Status"}),
				  #"Trimmed text" = Table.TransformColumns(#"Removed duplicates", {{"Program ID", each Text.Trim(_), type nullable text}, {"Program Name", each Text.Trim(_), type nullable text}, {"Cost Center", each Text.Trim(_), type nullable text}, {"Budget Category", each Text.Trim(_), type nullable text}, {"Funding Source", each Text.Trim(_), type nullable text}, {"Contract Number", each Text.Trim(_), type nullable text}, {"Status", each Text.Trim(_), type nullable text}}),
				  #"Capitalized each word" = Table.TransformColumns(#"Trimmed text", {{"Budget Category", each Text.Proper(_), type nullable text}, {"Status", each Text.Proper(_), type nullable text}}),
				  #"Inserted conditional column" = Table.AddColumn(#"Capitalized each word", "ProgramName", each if [Program Name] = "Next Gen Radar Systems" then "Next-Gen Radar Systems" else if [Program Name] = "Satellite Comm Upgrade" then "Satellite Communications Upgrade" else [Program Name]),
				  #"Replaced value" = Table.ReplaceValue(#"Inserted conditional column", "Sub-Contracts", "Subcontracts", Replacer.ReplaceText, {"Budget Category"}),
				  #"Removed columns" = Table.RemoveColumns(#"Replaced value", {"Program Name"}),
				  #"Changed column type 1" = Table.TransformColumnTypes(#"Removed columns", {{"ProgramName", type text}}),
				  #"Renamed columns" = Table.RenameColumns(#"Changed column type 1", {{"ProgramName", "Program Name"}}),
				  #"Replaced value 1" = Table.ReplaceValue(#"Renamed columns", "N/A", "", Replacer.ReplaceText, {"Actual Amount"}),
				  #"Replaced value 2" = Table.ReplaceValue(#"Replaced value 1", "N/A", "", Replacer.ReplaceText, {"Variance %"}),
				  #"Replaced value 3" = Table.ReplaceValue(#"Replaced value 2", "N/A", "", Replacer.ReplaceText, {"Variance"}),
				  #"Changed column type with locale" = Table.TransformColumnTypes(#"Replaced value 3", {{"Actual Amount", Currency.Type}, {"Variance", Currency.Type}, {"Variance %", Currency.Type}}, "en-US"),
				  #"Added custom" = Table.AddColumn(#"Changed column type with locale", "Fiscal Period", each [Fiscal Year] & " " & [Quarter]),
				  #"Changed column type 2" = Table.TransformColumnTypes(#"Added custom", {{"Fiscal Period", type text}})
				in
				  #"Changed column type 2"

	annotation PBI_ResultType = Table

