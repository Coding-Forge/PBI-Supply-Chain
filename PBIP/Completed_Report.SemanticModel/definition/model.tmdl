model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Budget vs Actuals","Program","Purchase Orders","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'Budget vs Actuals'
ref table Program
ref table 'Purchase Orders'
ref table _Measures

ref cultureInfo en-US

